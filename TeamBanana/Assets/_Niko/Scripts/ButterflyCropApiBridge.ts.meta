    - '// @input bool encodeJpg = true {"hint":"Encode crops as JPG instead of PNG for smaller API payloads"}'
    - '// @input bool enabledCapture = true {"hint":"Enable crop encoding and callback dispatch. Disable to keep the component dormant."}'
    - '// @input bool enableCropProcessing = true {"hint":"Master toggle for crop processing. Disable this when you only want detections without crop generation."}'
    - '// @input AssignableType_1[] payloadCallbacks = {} {"hint":"Optional scripts to notify when crops are ready"}'
    - '// @input string[] payloadCallbackFunctions = {} {"hint":"Function names on callback scripts. Each function receives ButterflyCropPayload[]"}'
    - '// @input Asset.RemoteServiceModule remoteServiceModule {"hint":"Optional authorized Remote Service asset for sending crops to an API"}'
    - '// @input string remoteEndpoint {"hint":"Authorized Remote Service endpoint name. Leave empty until the butterfly ID API is configured."}'
    - '// @input bool sendToRemoteWhenConfigured {"hint":"Send crop payloads through RemoteServiceModule when remoteServiceModule and remoteEndpoint are set"}'
    - '// @input bool debugLogging {"hint":"Log crop activity"}'
