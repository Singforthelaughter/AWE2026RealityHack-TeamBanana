  InputLines:
    - '// @input AssignableType mlSpatializer {"hint":"MLSpatializer component that emits best.onnx detections"}'
    - '// @input Asset.Texture sourceTexture {"hint":"Camera/input texture aligned with the ML model input"}'
    - '// @input Asset.Texture[] cropTextures = {} {"hint":"Screen Crop Texture assets used to crop detections. Assign 3 for up to 3 simultaneous butterflies."}'
    - '// @input float maxCropsPerBatch = 3 {"hint":"Maximum butterfly crops to produce per capture batch", "widget":"slider", "min":1, "max":3, "step":1}'
