  InputLines:
    - '// @ui {"widget":"label", "label":"Visual Prompt Cheatsheet"}'
    - '// @ui {"widget":"separator"}'
    - '// @input SceneObject panelRoot {"hint":"Optional root object for the visual cheatsheet panel. showPanel/hidePanel toggle this object."}'
