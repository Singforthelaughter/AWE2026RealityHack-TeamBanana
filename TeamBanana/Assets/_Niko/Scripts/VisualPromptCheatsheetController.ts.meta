    - '// @input string startMode = "idle" {"hint":"Mode shown on start if auto context detection has no active watched object.", "widget":"combobox", "values":[{"label":"Field Guide", "value":"idle"}, {"label":"Voice Assistant", "value":"voice"}, {"label":"Identify Butterflies", "value":"identification"}, {"label":"Scan For Butterflies", "value":"detection"}, {"label":"Nearby Sightings", "value":"map"}, {"label":"Collection", "value":"collection"}, {"label":"Spatial Awareness", "value":"spatial"}, {"label":"Generate Assets", "value":"generation"}, {"label":"Palm Push To Talk", "value":"palmTalk"}]}'
