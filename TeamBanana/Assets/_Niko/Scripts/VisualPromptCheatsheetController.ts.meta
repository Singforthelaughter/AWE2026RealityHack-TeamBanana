    - '// @input float rotateSeconds = 8 {"hint":"Seconds between automatic prompt page changes."}'
    - '// @input float contextPollSeconds = 0.35 {"hint":"Seconds between context checks."}'
    - '// @input bool debugLogging {"hint":"Enable debug logging."}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"Context Watchers"}'
