  InputLines:
    - '// @input AssignableType mlSpatializer {"hint":"The MLSpatializer that emits detections"}'
    - '// @input SceneObject[] boxObjects = {} {"hint":"Screen object(s) reused as boxes. Repositioned onto detections. Need at least one, even if you only want the label."}'
    - '// @input Component.Text[] labelTexts = {} {"hint":"Optional: a Text per box (same order). If empty, the script auto-finds a Text inside each box."}'
    - '// @input float minScore {"hint":"Only show detections at or above this confidence", "widget":"slider", "min":0, "max":1, "step":0.01}'
    - '// @input float smoothing = 0.6 {"hint":"Box smoothing. 0 = snap instantly (jittery), 0.8 = smooth glide (slight lag). Try 0.6.", "widget":"slider", "min":0, "max":0.95, "step":0.05}'
    - '// @input float holdSeconds = 0.5 {"hint":"Seconds to keep a box/label visible after detection drops out, to stop flicker. Try 0.5.", "widget":"slider", "min":0, "max":2, "step":0.05}'
    - '// @input float boxScaleX = 1 {"hint":"Box width multiplier. Raise if the box is too narrow for the butterfly (webcam aspect fix).", "widget":"slider", "min":0.5, "max":3, "step":0.05}'
    - '// @input float boxScaleY = 1 {"hint":"Box height multiplier. Raise if the box is too short for the butterfly (webcam aspect fix).", "widget":"slider", "min":0.5, "max":3, "step":0.05}'
    - '// @input bool flipX {"hint":"Mirror horizontally if boxes land on the wrong side"}'
    - '// @input bool flipY {"hint":"Flip vertically if boxes are upside down"}'
    - '// @input bool showBox {"hint":"Show the box outline. Off = only the label is shown (no rectangle)."}'
    - '// @input bool debugLogging = true {"hint":"Log activity to the Logger panel"}'
    - '// @input SceneObject statusObject {"hint":"Fixed object shown when a butterfly is detected, hidden otherwise. Placed by you - the script never moves it. Its PARENT must stay enabled."}'
